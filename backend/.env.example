# Copy this file to .env and adjust the values. Never commit .env.

# App
NODE_ENV=development
PORT=3000
# Comma-separated list of allowed frontend origins
CORS_ORIGIN=http://localhost:5173

# Database (matches docker-compose.yml defaults)
DB_HOST=localhost
DB_PORT=5433
DB_USER=checkout
DB_PASSWORD=checkout
DB_NAME=checkout
DB_SSL=false
# Run pending migrations automatically when the app starts
DB_RUN_MIGRATIONS=false

# Payment gateway (sandbox only). Use the sandbox URL and keys given in the
# challenge instructions. Never commit real values.
PAYMENT_API_URL=https://<sandbox-api-host>/v1
PAYMENT_PUBLIC_KEY=pub_test_xxx
PAYMENT_PRIVATE_KEY=prv_test_xxx
PAYMENT_INTEGRITY_SECRET=test_integrity_xxx
PAYMENT_EVENTS_SECRET=test_events_xxx
PAYMENT_TIMEOUT_MS=8000
# How many times / how often to ask for the final status of a payment
PAYMENT_POLL_ATTEMPTS=10
PAYMENT_POLL_INTERVAL_MS=2000
# Total polling budget (max wait + timeout must stay under 29 s)
PAYMENT_POLL_MAX_WAIT_MS=15000

# Checkout fees in cents (COP). Base fee is always charged.
BASE_FEE_IN_CENTS=300000
DELIVERY_FEE_IN_CENTS=1000000
